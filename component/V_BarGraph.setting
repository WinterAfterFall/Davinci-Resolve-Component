			Tools = ordered() {
				Bar_GC = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Center = Input {
							Value = { 0.18, 0.4125 },
							Expression = "Point(LeftMargin + (1 - LeftMargin - RightMargin)/Columns*(Position - 0.5), BottomMargin + (BarH - BottomExt)/2)",
						},
						Width = Input {
							Value = 0.096,
							Expression = "BarW",
						},
						Height = Input {
							Value = 0.45,
							Expression = "BarH + BottomExt",
						},
						CornerRadius = Input { Value = 0.3, },
						BorderSize = Input { Value = 0.004, },
						BarW = Input { Expression = "(1 - LeftMargin - RightMargin)/Columns*(1 - Padding)", },
						BottomExt = Input { Expression = "BarW/2*comp:GetPrefs(\"Comp.FrameFormat.Width\")/comp:GetPrefs(\"Comp.FrameFormat.Height\")", },
						BarH = Input { Expression = "(1 - TopMargin - BottomMargin)/(Max - Min)*(Value - Min)*Grow", },
						LeftMargin = Input { Value = 0.1, },
						RightMargin = Input { Value = 0.1, },
						TopMargin = Input { Value = 0.15, },
						BottomMargin = Input { Value = 0.25, },
						Columns = Input { Value = 5, },
						Position = Input { Value = 1, },
						Padding = Input { Value = 0.4, },
						Max = Input { Value = 100, },
						Min = Input { Value = 0, },
						Value = Input { Value = 75, },
						Visibility = Input { Value = 1, },
						TitleTime = Input { Value = 1, },
						GraphTime = Input { Value = 4, },
						TotalTime = Input { Expression = "BaseTime*Columns+TitleTime+GraphTime", },
						Pop = Input { Expression = "(TitleTime <= 0) and ((Visibility >= BaseTime*Columns/TotalTime) and 1 or 0) or math.min(1, math.max(0, (Visibility - BaseTime*Columns/TotalTime)/(TitleTime/TotalTime)))", },
						Grow = Input { Expression = "(Visibility <= (BaseTime*Columns/TotalTime + TitleTime/TotalTime)) and 0 or (Visibility >= 1) and 1 or 1 - (1 - (Visibility - BaseTime*Columns/TotalTime - TitleTime/TotalTime)/(GraphTime/TotalTime))^3", },
						LabelScale = Input { Value = 0.55, },
						LabelGap = Input { Value = 0.015, },
						UseImage = Input { Value = 1, },
						ImageSize = Input { Value = 1, },
						ImageGap = Input { Value = 0, },
						ShowBaseline = Input { Value = 1, },
						BaseTime = Input { Value = 1, },
						BaseGrow = Input { Expression = "(BaseTime <= 0) and 1 or math.min(1, math.max(0, Visibility*TotalTime/BaseTime - (BaseIdx - 1)))", },
						BaseIdx = Input { Expression = "(BaseSlot >= 1) and BaseSlot or Position", },
						BaseSlot = Input { Value = 0, },
						BaseFull = Input { Value = 0, },
						BaseAll = Input { Expression = "(BaseTime <= 0) and 1 or math.min(1, math.max(0, Visibility*TotalTime/(BaseTime*Columns)))", },
						BaseThickness = Input { Value = 0.006, }
					},
					ViewInfo = OperatorInfo { Pos = { -330, -16.5 } },
					UserControls = ordered() {
						HdrAnimation = { LINKID_DataType = "Number", INPID_InputControl = "LabelControl", LBLC_DropDownButton = true, LBLC_NumInputs = 4, INP_Integer = false, INP_External = false, INP_Passive = true, INP_Default = 1, ICS_ControlPage = "Controls", LINKS_Name = "Animation" },
